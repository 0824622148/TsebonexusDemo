# Plesk FTP account for the hosting subscription that holds tsebonexus.co.za.
# Copy to .env (git-ignored) and fill in. Run `npm run deploy:live:list` to confirm FTP_REMOTE_DIR.
FTP_HOST=spanbi.co.za
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# true = explicit FTPS (AUTH TLS) on port 21; set to false if the server only speaks plain FTP
FTP_SECURE=true
# Web root. The FTP account for tsebonexus.co.za is chrooted straight into its httpdocs, so this is /
FTP_REMOTE_DIR=/
