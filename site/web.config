<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Static site settings (added at go-live, Sept 2026). Sections below this are Plesk-managed. -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
    <httpErrors>
      <remove statusCode="400" />
      <error statusCode="400" path="F:\Domains\spanbi.co.za\error_docs\bad_request.html" />
      <remove statusCode="401" />
      <error statusCode="401" path="F:\Domains\spanbi.co.za\error_docs\unauthorized.html" />
      <remove statusCode="403" />
      <error statusCode="403" path="F:\Domains\spanbi.co.za\error_docs\forbidden.html" />
      <remove statusCode="404" />
      <error statusCode="404" path="F:\Domains\spanbi.co.za\error_docs\not_found.html" />
      <remove statusCode="405" />
      <error statusCode="405" path="F:\Domains\spanbi.co.za\error_docs\method_not_allowed.html" />
      <remove statusCode="406" />
      <error statusCode="406" path="F:\Domains\spanbi.co.za\error_docs\not_acceptable.html" />
      <remove statusCode="407" />
      <error statusCode="407" path="F:\Domains\spanbi.co.za\error_docs\proxy_authentication_required.html" />
      <remove statusCode="412" />
      <error statusCode="412" path="F:\Domains\spanbi.co.za\error_docs\precondition_failed.html" />
      <remove statusCode="414" />
      <error statusCode="414" path="F:\Domains\spanbi.co.za\error_docs\request-uri_too_long.html" />
      <remove statusCode="415" />
      <error statusCode="415" path="F:\Domains\spanbi.co.za\error_docs\unsupported_media_type.html" />
      <remove statusCode="500" />
      <error statusCode="500" path="F:\Domains\spanbi.co.za\error_docs\internal_server_error.html" />
      <remove statusCode="501" />
      <error statusCode="501" path="F:\Domains\spanbi.co.za\error_docs\not_implemented.html" />
      <remove statusCode="502" />
      <error statusCode="502" path="F:\Domains\spanbi.co.za\error_docs\bad_gateway.html" />
      <remove statusCode="503" />
      <error statusCode="503" path="F:\Domains\spanbi.co.za\error_docs\maintenance.html" />
    </httpErrors>
    <tracing>
      <traceFailedRequests>
        <clear />
      </traceFailedRequests>
    </tracing>
  </system.webServer>
  <system.web>
    <compilation tempDirectory="F:\Domains\spanbi.co.za\tmp" />
  </system.web>
  <!-- Short cache for the page itself so content updates show up quickly; assets keep the 7-day cache above. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:10:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>